{
  "repo": {
    "owner": "sandeepsalwan1",
    "name": "Vet",
    "defaultBranch": "main"
  },
  "commands": {
    "install": "npm ci",
    "quality": [
      "git diff --check",
      "npm run typecheck",
      "npm run lint",
      "npm run lint:dead",
      "npm run lint:duplicates"
    ],
    "build": "npm run build",
    "scenarios": "npm run test:scenarios",
    "defaultImplementChecks": [
      "npm run typecheck",
      "npm run lint"
    ],
    "normalImplementChecks": [
      "npm run build",
      "npm run lint",
      "npm run test:scenarios"
    ],
    "proof": [
      "npm run build",
      "npm run test:scenarios"
    ],
    "serviceProof": [
      "npm ci --ignore-scripts --no-audit --no-fund",
      "npm run db:migrate",
      "AGENT_DISPOSABLE_DATABASE=1 npm run db:proof",
      "npm run build",
      "npm run test:scenarios"
    ],
    "localSmoke": "npm run smoke:local"
  },
  "render": {
    "serviceName": "vetagent-internal",
    "serviceUrl": "https://vetagent-internal.onrender.com",
    "deployTimeoutSeconds": 1200,
    "pollSeconds": 15,
    "healthTimeoutSeconds": 55,
    "cli": {
      "version": "2.22.0",
      "linuxAmd64Asset": "cli_2.22.0_linux_amd64.zip",
      "linuxAmd64Sha256": "6cdcd11897b7bd7e673317e6f4aaf041b654d818444f3b1efec7240a835f79ec"
    },
    "healthChecks": [
      {
        "url": "https://vetagent-internal.onrender.com/api/clinic",
        "expectedStatus": 200,
        "expectedClinicSlug": "tri-city-vet",
        "expectedHostname": "vetagent-internal.onrender.com"
      },
      {
        "url": "https://centralvet.eepish.com/api/clinic",
        "expectedStatus": 200,
        "expectedClinicSlug": "central-vet",
        "expectedHostname": "centralvet.eepish.com"
      },
      {
        "url": "https://tricityvet.eepish.com/api/clinic",
        "expectedStatus": 200,
        "expectedClinicSlug": "tri-city-vet",
        "expectedHostname": "tricityvet.eepish.com"
      }
    ]
  },
  "labels": {
    "triage": "agent:triage",
    "implement": "agent:implement",
    "review": "agent:review",
    "proof": "agent:proof",
    "proofFailed": "agent:proof-failed",
    "automerge": "agent:automerge",
    "blocked": "agent:blocked",
    "postMergeFailed": "agent:post-merge-failed",
    "priorityHigh": "priority:high",
    "priorityTrivial": "priority:trivial",
    "priorityLow": "priority:low"
  },
  "comments": {
    "propose": "<!-- agent-propose:v1 -->",
    "triage": "<!-- agent-triage:v1 -->",
    "review": "<!-- agent-review:v1 -->",
    "proof": "<!-- agent-proof:v1 -->",
    "gate": "<!-- agent-gate:v1 -->",
    "cost": "<!-- agent-cost:v1 -->",
    "postMerge": "<!-- agent-post-merge:v1 -->"
  },
  "concurrency": {
    "hardMaxGlobal": 15,
    "maxGlobal": 8,
    "groupPrefix": "agent-work-v1",
    "lanes": {
      "proposer": 1,
      "triage": 2,
      "implement": 2,
      "review": 2,
      "proof": 1
    }
  },
  "backend": {
    "default": "codex",
    "allowed": [
      "codex"
    ],
    "codexAction": "openai/codex-action@v1",
    "model": "gpt-5.4-mini",
    "effort": "low",
    "proposerModel": "gpt-5.4-mini",
    "proposerEffort": "low",
    "reviewModel": "gpt-5.4-mini",
    "reviewEffort": "low",
    "noMistakesModel": "gpt-5.4-mini",
    "noMistakesEffort": "medium",
    "sandbox": "workspace-write",
    "readOnlySandbox": "read-only"
  },
  "secrets": {
    "agentAuth": "OPENAI_API_KEY",
    "githubWrite": "GITHUB_TOKEN",
    "githubPublisher": "AGENT_GITHUB_TOKEN",
    "githubPat": "AGENT_PAT",
    "crabboxCoordinator": "CRABBOX_COORDINATOR_TOKEN",
    "crabboxProviders": [
      "HCLOUD_TOKEN",
      "HETZNER_TOKEN",
      "HETZNER_API_TOKEN"
    ],
    "vercel": [
      "VERCEL_TOKEN",
      "VERCEL_OIDC_TOKEN"
    ]
  },
  "crabbox": {
    "preferWhenProviderAuthExists": true,
    "credentialFreeVisualFallback": "local-container",
    "readiness": {
      "vercel": "CRABBOX_VERCEL_READY",
      "hetzner": "CRABBOX_HETZNER_READY"
    },
    "nonVisualProviders": [
      "vercel-sandbox",
      "hetzner"
    ],
    "visualProviders": [
      "hetzner",
      "local-container"
    ],
    "lanes": {
      "implementRemote": [],
      "implementRepairRemote": [],
      "reviewRemote": [],
      "noMistakesRemote": [],
      "readinessRemote": [],
      "fallbackReadinessRemote": [],
      "ciRemote": [
        "npm run build",
        "npm run test:scenarios"
      ],
      "smokeRemote": [
        "npm run smoke:local"
      ],
      "visualProof": [
        "npm run smoke:local"
      ],
      "gifProof": []
    }
  },
  "readiness": {
    "status": "agent-readiness",
    "workflow": "agent-readiness.yml",
    "baselineWorkflow": "ci.yml",
    "maxAgeHours": 26,
    "baselineChecks": [
      "quality",
      "build",
      "scenarios",
      "audit"
    ],
    "primaryProvider": "vercel-sandbox",
    "fallbackProvider": "local-container",
    "alertTitle": "AFK automation readiness drift"
  },
  "cost": {
    "status": "agent-cost",
    "authenticationMode": "metered-api",
    "modelPricing": {
      "version": "openai-2026-03-17",
      "source": "https://developers.openai.com/api/docs/models/gpt-5.4-mini",
      "models": {
        "gpt-5.4-mini": {
          "inputPerMillionUsd": 0.75,
          "cachedInputPerMillionUsd": 0.075,
          "outputPerMillionUsd": 4.5
        },
        "gpt-5.4-mini-2026-03-17": {
          "inputPerMillionUsd": 0.75,
          "cachedInputPerMillionUsd": 0.075,
          "outputPerMillionUsd": 4.5
        }
      }
    },
    "vercelSandboxPricing": {
      "version": "vercel-2026-07-24",
      "source": "https://vercel.com/pricing",
      "defaultVcpus": 2,
      "memoryGbPerVcpu": 2,
      "activeCpuPerHourUsd": 0.128,
      "memoryPerGbHourUsd": 0.0212,
      "creationPerMillionUsd": 0.6
    },
    "hetznerCloudPricing": {
      "version": "hetzner-2026-06-15",
      "source": "https://docs.hetzner.com/general/infrastructure-and-availability/price-adjustment/",
      "billingSource": "https://docs.hetzner.com/cloud/billing/faq/",
      "machineClass": "beast",
      "location": "fsn1",
      "fallbackTypes": [
        "ccx63",
        "ccx53",
        "ccx43",
        "cpx62",
        "cx53"
      ],
      "maximumServerPerHourUsd": 1.6138,
      "primaryIpv4PerHourUsd": 0.001,
      "billingIncrementHours": 1
    }
  },
  "automerge": {
    "requiredLabels": [
      "agent:automerge"
    ],
    "blockedLabels": [
      "priority:high",
      "agent:blocked",
      "agent:proof-failed"
    ],
    "requiredChecks": [
      "quality",
      "build",
      "scenarios",
      "audit",
      "dependency-review"
    ],
    "requiredStatuses": [
      "agent-review",
      "agent-cost",
      "no-mistakes"
    ],
    "noMistakesBypassStatus": "no-mistakes-bypass",
    "proofStatus": "agent-proof",
    "manualWhenPriority": [
      "high"
    ],
    "manualWhenRisk": [
      "high"
    ]
  }
}
